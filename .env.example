# Copy this file to .env before running the app:  cp .env.example .env

# Database connection. SQLite is file-based, so no server is required.
# The path is relative to the prisma/ directory.
DATABASE_URL="file:./dev.db"

# --- Mock external system tuning (demo only) -------------------------------
# Probability that the mock external service fails, so retry behaviour is
# observable. Set to 0 for a always-succeeding demo, 1 to always fail.
MOCK_SYNC_FAILURE_RATE=0.4

# Upper bound of artificial latency the mock service adds, in milliseconds.
MOCK_SYNC_MAX_LATENCY_MS=600

# Client-side timeout when calling the external system, in milliseconds.
EXTERNAL_SYNC_TIMEOUT_MS=3000
